{
  "rewrites": [
    {
      "source": "/twin/pledge-map.json",
      "destination": "https://jungnang-media.vercel.app/data/pledge-map.json"
    },
    {
      "source": "/twin/editions.json",
      "destination": "https://jungnang-media.vercel.app/data/editions.json"
    }
  ],
  "headers": [
    {
      "source": "/twin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}